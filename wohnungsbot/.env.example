# Wohnungsbot – Geheimnisse. Kopieren nach .env und ausfüllen:  cp .env.example .env
# Diese Datei NIE weitergeben oder in Git hochladen.

# Telegram: Bot bei @BotFather anlegen (/newbot) -> Token hier eintragen.
TELEGRAM_TOKEN=
# Deine Chat-ID: Bot starten, ihm in Telegram /start schreiben -> er antwortet mit der ID.
TELEGRAM_CHAT_ID=

# Postfach, in dem die Suchauftrags-Mails der Portale landen (Gmail: App-Passwort nötig).
IMAP_HOST=imap.gmail.com
IMAP_BENUTZER=
IMAP_PASSWORT=

# Versand der Bewerbungen (optional – ohne SMTP kopierst du den Text ins Kontaktformular).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_BENUTZER=
SMTP_PASSWORT=
# Absenderadresse (Standard: SMTP_BENUTZER)
SMTP_ABSENDER=

# Schlüssel für die verschlüsselten Unterlagen. Erzeugen: python -m wohnungsbot schluessel
UNTERLAGEN_SCHLUESSEL=
